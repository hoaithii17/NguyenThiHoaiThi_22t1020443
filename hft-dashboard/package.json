{
  "name": "hft-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_EXTRA_CA_CERTS=$(mkcert -CAROOT)/rootCA.pem bun --bun next dev --turbopack --experimental-https",
    "dev:win": "node scripts/with-mkcert-ca.mjs bun --bun next dev --turbopack --experimental-https",
    "build": "bun --bun next build",
    "start": "NODE_EXTRA_CA_CERTS=$(mkcert -CAROOT)/rootCA.pem bun --bun next start",
    "start:win": "node scripts/with-mkcert-ca.mjs bun --bun next start",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lightweight-charts": "^5.1.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
